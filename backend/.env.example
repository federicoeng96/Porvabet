DATABASE_URL=postgresql+psycopg://porvabet:porvabet_dev@localhost:5432/porvabet
API_FOOTBALL_KEY=
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
ENV=development

# Betfair Exchange (official Betting API, personal account — see DATA_SOURCES.md).
# BETFAIR_APP_KEY must be a free "Delayed" Application Key obtained from your own
# Betfair account (developer.betfair.com) — never the paid "Live" key, which this
# project never requests. All three optional: BetfairExchangeOddsProvider degrades
# to is_available()=False, never fabricated odds, when any is missing.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# football-data.org (category A, see DATA_SOURCES.md) — free key from your own
# account (football-data.org -> "Get started"), used only to fetch the next
# matchday's Premier League/Serie A fixtures. Optional: FootballDataOrgFixtureProvider
# degrades to is_available()=False, never a fabricated fixture, when missing.
FOOTBALL_DATA_ORG_API_KEY=
